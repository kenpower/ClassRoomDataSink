{
  "name": "@roomsink/api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --project db",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/websocket": "^11.3.7",
    "ajv": "^8.20.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "mysql2": "^3.24.6",
    "ulid": "^3.0.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.2.2",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "testcontainers": "^12.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
