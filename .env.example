# Copy to .env (never commit it). Values shown are examples.

# Public base URL of this stack (what browsers use), no trailing slash.
PUBLIC_URL=https://roomsink.example.ie
# Host interface/port the proxy container publishes (put TLS nginx in front of it).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# --- Database (MySQL 8.4). The API uses DB_USER (DML only); migrations use DB_MIGRATE_USER (DDL). ---
DB_NAME=roomsink
DB_USER=roomsink
DB_PASSWORD=change-me-app
DB_MIGRATE_USER=roomsink_migrate
DB_MIGRATE_PASSWORD=change-me-migrate
DB_ROOT_PASSWORD=change-me-root
DB_POOL_SIZE=20
# Each *_PASSWORD / *_SECRET can instead be given as *_FILE pointing at a Docker secret.

# --- Join tokens. At least 32 random bytes: openssl rand -base64 48 ---
TOKEN_SECRET=
TOKEN_KID=k1

# --- Staff sign-in via the STARS auth service ---
AUTH_BASE_URL=https://compucore2.setu.ie/auth
# The shared HS256 secret from the auth-service administrator (JWT_SECRET_KEY). Server-side only.
AUTH_JWT_SECRET=
AUTH_PROVIDERS=microsoft,google
# Who counts as staff: anyone at these email domains (subdomains included) ...
STAFF_EMAIL_DOMAINS=setu.ie
# ... plus these addresses (any domain, e.g. Gmail).
STAFF_EMAILS=
# Admins see every room. Any address works, including Gmail. Admins are also staff.
ADMIN_EMAILS=
# Optional: reject STARS tokens older than this many seconds (only if the token carries iat). 0 = off.
AUTH_TOKEN_MAX_AGE_S=0
# RoomSink's own staff session: lifetime, and the most a session can be silently renewed to.
SESSION_HOURS=8
SESSION_MAX_HOURS=12

# --- CORS ---
# Origins of the student-facing web apps ('*' is fine: client calls use bearer tokens, not cookies).
CORS_CLIENT_ORIGINS=*
# Only needed if the admin SPA is served from a different origin than the API.
ADMIN_ORIGIN=

# --- Admin build ---
# API base URL baked into the admin SPA; empty = same origin (the default with the proxy).
ADMIN_API_URL=
# Default client app URL for the dashboard's join-link/QR builder (the room code is added as ?r=CODE).
CLIENT_URL=https://apps.example.ie/quiz/

# --- Network ---
# Optional CIDR allowlist for the whole API. Leave empty so students and staff can connect from home.
IP_ALLOWLIST=
# Only trust X-Forwarded-For from these proxies.
TRUST_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

LOG_LEVEL=info
